# ── Mobile App Environment Variables ─────────────────────────────────────────
#
# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit it.
#
# Usage:
#   cp .env.example .env
#   then edit .env with your local backend URL

# ── Backend API URL (required) ────────────────────────────────────────────────
#
# Option A — same WiFi as backend machine:
#   Find your computer's IPv4 address (Windows: ipconfig, Mac/Linux: ifconfig)
#   EXPO_PUBLIC_API_URL=http://192.168.1.105:3001/api
#
# Option B — ngrok tunnel (works across networks):
#   Run: ngrok http 3001
#   Copy the https://xxxx.ngrok-free.app URL from the ngrok output
#   EXPO_PUBLIC_API_URL=https://xxxx.ngrok-free.app/api
#
EXPO_PUBLIC_API_URL=http://localhost:3001/api
